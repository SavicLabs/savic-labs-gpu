{
  "name": "savic-labs-gpu",
  "displayName": "SavicLabs GPU Monitor",
  "description": "Real-time GPU monitor in your VS Code status bar. VRAM, temperature, utilization — click for detail panel. NVIDIA, AMD, Intel, Apple Silicon. Windows, Linux, macOS.",
  "icon": "resources/icon.png",
  "version": "0.2.3",
  "publisher": "SavicLabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SavicLabs/savic-labs-gpu.git"
  },
  "homepage": "https://saviclabs.com",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "gpu",
    "nvidia",
    "amd",
    "vram",
    "monitor",
    "hardware",
    "ai",
    "machine learning",
    "llm"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "savicLabsGpu.toggle",
        "title": "Toggle GPU Monitor"
      },
      {
        "command": "savicLabsGpu.openPanel",
        "title": "Open GPU Detail Panel"
      },
      {
        "command": "savicLabsGpu.refresh",
        "title": "Refresh GPU Stats"
      },
      {
        "command": "savicLabsGpu.cycleGpu",
        "title": "Cycle GPU Display"
      }
    ],
    "configuration": {
      "title": "SavicLabs GPU Monitor",
      "properties": {
        "savicLabsGpu.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%savicLabsGpu.config.enabled%"
        },
        "savicLabsGpu.pollIntervalMs": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "maximum": 30000,
          "description": "%savicLabsGpu.config.pollIntervalMs%"
        },
        "savicLabsGpu.alertVramPercent": {
          "type": "number",
          "default": 85,
          "minimum": 50,
          "maximum": 100,
          "description": "%savicLabsGpu.config.alertVramPercent%"
        },
        "savicLabsGpu.alertTempCelsius": {
          "type": "number",
          "default": 85,
          "minimum": 60,
          "maximum": 110,
          "description": "%savicLabsGpu.config.alertTempCelsius%"
        },
        "savicLabsGpu.statusBarFormat": {
          "type": "string",
          "default": "GPU ${name} · ${vramUsed}/${vramTotal} · ${temp}°C",
          "description": "%savicLabsGpu.config.statusBarFormat%"
        },
        "savicLabsGpu.showUtilization": {
          "type": "boolean",
          "default": false,
          "description": "%savicLabsGpu.config.showUtilization%"
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true, maxRetries: 3 })\"",
    "vscode:prepublish": "npm run compile",
    "compile": "npm run clean && tsc -p ./",
    "watch": "npm run clean && tsc -watch -p ./",
    "lint": "tsc --noEmit -p ./"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/SavicLabs/savic-labs-gpu/issues"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^4.1.0",
    "ovsx": "^1.3.0",
    "typescript": "^7.0.2"
  }
}
